#!/usr/bin/env bash
## Description: Recreate the DDEV project, install dependencies, remove canvas module, and print a login URL.
## Usage: demo-setup

set -euo pipefail

ddev delete -O -y
ddev start
ddev composer install

# Canvas is currently required as a dev release. Composer installs dev modules from
# their Git repository, and we also apply a patch to Canvas. That makes Git think
# many files in web/modules/contrib/canvas are changed, which clutters IDE sidebars.
# Remove the module's .git directory as a workaround.
rm -rf web/modules/contrib/canvas/.git

## This recipe was generated with the command  ddev drush site:export --destination=../custom_recipes/findrop
ddev drush si ../custom_recipes/findrop -y

ddev drush en ai_context -y
ddev drush recipe ../custom_recipes/ai_context_setup

echo "Building Canvas UI assets..."
REQUIRED_NODE_MAJOR=20
REQUIRED_NODE_MINOR=19
NODE_VERSION=$(node --version 2>/dev/null | sed 's/v//')
if [ -z "$NODE_VERSION" ]; then
  echo "Error: Node.js is not installed. Please install Node.js >= ${REQUIRED_NODE_MAJOR}.${REQUIRED_NODE_MINOR}.0 to continue."
  exit 1
fi
NODE_MAJOR=$(echo "$NODE_VERSION" | cut -d. -f1)
NODE_MINOR=$(echo "$NODE_VERSION" | cut -d. -f2)
if [ "$NODE_MAJOR" -lt "$REQUIRED_NODE_MAJOR" ] || { [ "$NODE_MAJOR" -eq "$REQUIRED_NODE_MAJOR" ] && [ "$NODE_MINOR" -lt "$REQUIRED_NODE_MINOR" ]; }; then
  echo "Error: Node.js ${NODE_VERSION} is below the required version ${REQUIRED_NODE_MAJOR}.${REQUIRED_NODE_MINOR}.0."
  echo "Please update Node.js before running demo-setup."
  exit 1
fi
(cd web/modules/contrib/canvas && npm install)
(cd web/modules/contrib/canvas/ui && npm run build)

echo "Seeding demo analytics data..."
ddev drush php:eval '
  $page_ids = array_values(\Drupal::entityQuery("canvas_page")->accessCheck(FALSE)->range(0, 20)->execute());
  if (empty($page_ids)) { echo "No canvas pages found, skipping.\n"; return; }
  $flags = [
    ["summary" => "Bounce rate is 78.3% (threshold: 70% max). Engaged sessions dropped to 42 over the last 90 days (threshold: 100 min).\n\nRecommendations: Add a stronger call-to-action above the fold. Consider breaking long-form content into scannable sections with subheadings.", "m" => ["42", "78.3", "3.1"]],
    ["summary" => "Key event rate is 0.8% (threshold: 2% min). Users land on this page but rarely take action.\n\nRecommendations: Increase CTA contrast and size. Move the contact form higher on the page. Add social proof near the conversion point.", "m" => ["215", "52.1", "0.8"]],
    ["summary" => "All three metrics are underperforming. Bounce rate: 85.2% (max 70%). Engaged sessions: 18 (min 100). Key event rate: 0.4% (min 2%).\n\nRecommendations: This page may have a content-intent mismatch. Review the page title and meta description for accuracy.", "m" => ["18", "85.2", "0.4"]],
  ];
  $context_data = [];
  foreach ($flags as $i => $flag) {
    if (!isset($page_ids[$i])) break;
    $page = \Drupal\canvas\Entity\Page::load($page_ids[$i]);
    if (!$page) continue;
    $page->set("monitor", TRUE);
    $page->set("engaged_sessions", $flag["m"][0]);
    $page->set("bounce_rate", $flag["m"][1]);
    $page->set("key_event_rate", $flag["m"][2]);
    $page->save();
    $context_data[$page->id()] = ["summary" => $flag["summary"]];
  }
  \Drupal::state()->set("ai_google_analytics.context_data", $context_data);
  echo "Seeded analytics demo data for " . count($context_data) . " pages.\n";
'

echo "Preparing to index content..."
sleep 3
OPENAI_API_KEY_VALUE=$(grep '^OPENAI_API_KEY=' "${DDEV_APPROOT}/.ddev/.env" 2>/dev/null | cut -d= -f2- | tr -d '"')
if [ -n "${OPENAI_API_KEY_VALUE}" ]; then
  echo "Enabling AI search servers..."
  ddev drush config:set search_api.server.canvas_page_search status true -y
  ddev drush config:set search_api.server.media_image_search status true -y
  echo "Indexing all content in the vector database..."
  ddev drush sapi-i
else
  echo "Skipping content indexing because OPENAI_API_KEY is not set in .ddev/.env"
fi

echo "Demo setup complete. You can log in to the Drupal site using the following URL:"
ddev drush uli
